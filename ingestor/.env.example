# Async PostgreSQL + TimescaleDB connection. Use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://iot:changeme@postgres:5432/iot

# MQTT broker connection. Username/password must exist in the broker's
# passwords file (see infra/mosquitto/scripts/).
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=ingestor
MQTT_PASSWORD=changeme

# Subscription pattern. Single-level wildcard captures all device topics.
MQTT_TOPIC=devices/+/telemetry

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
