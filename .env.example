# =============================================================================
# IoT Temperature Platform — example environment file
# Copy this file to `.env` and fill in real values for local development.
# In production (Coolify), each service receives its own env vars from the
# Coolify UI; this file documents which variables each service expects.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL / TimescaleDB
# Consumed by: postgres container (init), backend, ingestor, alembic
# -----------------------------------------------------------------------------
POSTGRES_USER=iot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=iot

# Async SQLAlchemy connection string used by backend + ingestor.
# Use the service name `postgres` inside docker-compose; use the real host in prod.
DATABASE_URL=postgresql+asyncpg://iot:changeme@postgres:5432/iot

# -----------------------------------------------------------------------------
# MQTT (Mosquitto)
# Consumed by: ingestor (subscriber), and any future backend publishers
# -----------------------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=ingestor
MQTT_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Backend API auth (v1)
# A single static bearer token gates the API in v1. Real JWT auth comes later.
# Consumed by: backend, web (as VITE_API_URL is the only frontend-side var,
# the token is held server-side or supplied via a future login flow).
# -----------------------------------------------------------------------------
API_TOKEN=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# Web frontend
# Consumed by: web (Vite reads VITE_-prefixed vars at build time)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
