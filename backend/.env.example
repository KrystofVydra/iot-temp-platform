# Async PostgreSQL + TimescaleDB connection. Use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://iot:changeme@postgres:5432/iot

# Static bearer token for v1 auth. Generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
API_TOKEN=replace-with-a-long-random-string

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins. Leave empty to disable CORS.
# Example: CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=
