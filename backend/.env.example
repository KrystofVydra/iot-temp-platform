# Async PostgreSQL + TimescaleDB connection. Use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://iot:changeme@postgres:5432/iot

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins. Leave empty to disable CORS.
# Credentialed CORS (cookies) requires a specific origin — '*' is rejected.
# Example: CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=

# Origin used to build invitation and password-reset URLs.
FRONTEND_ORIGIN=https://app.otti.cz

# While True, /auth/forgot-password and /auth/issue-invitation expose the
# raw URL in their response body so an operator can hand-deliver it. Flip
# to False once outbound email is wired up.
EXPOSE_AUTH_LINKS=true

# bcrypt cost factor. 12 is the modern default (~250 ms / hash on a mid CPU).
BCRYPT_ROUNDS=12
